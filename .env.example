ENVIRONMENT=development
DEBUG=true
AUTH_ENABLED=false
INIT_DB_ON_STARTUP=true
ENABLE_API_DOCS=true
APP_EDITION=full
APP_DISPLAY_NAME=cherry2
RUNTIME_PROFILE=full
PROCESSING_RUNNER=celery
MAX_ACTIVE_JOBS=1
LITE_JOB_LEASE_TTL_SECONDS=900
LITE_JOB_HEARTBEAT_SECONDS=15
UVICORN_RELOAD=false

# Generate for production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
ACCESS_TOKEN_EXPIRE_MINUTES=30
INITIAL_ADMIN_PASSWORD=change-me-before-first-init
INITIAL_ADMIN_EMAIL=admin@example.com

DATABASE_URL=postgresql://user:password@db:5432/speech_to_information
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=speech_to_information

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000
FLOWER_PORT=5555
FLOWER_USER=flower
FLOWER_PASSWORD=change-me

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/

RATE_LIMIT_ENABLED=true
MAX_UPLOAD_SIZE=100000000
ALLOWED_EXTENSIONS=["wav","mp3","m4a","ogg"]
AUDIO_STORAGE_ROOT=storage/audio

ASR_PROVIDER=cherry_whisper_v2
ASR_PROFILE=full
ENABLE_DIARIZATION_DEFAULT=true
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=8
WHISPER_BEAM_SIZE=10
WHISPER_INITIAL_PROMPT=Cuộc hội thoại tiếng Việt, có thể xen kẽ thuật ngữ tiếng Anh, tên riêng, số điện thoại, ngày giờ, địa chỉ và số tiền. Giữ nguyên thuật ngữ tiếng Anh khi nghe rõ.
WHISPER_HOTWORDS=SpeechToInformation, Speech to Information, số điện thoại, ngày mai, hôm nay, địa chỉ, khách hàng, công ty, hợp đồng, thanh toán
DEFAULT_LANGUAGE=vi
WHISPER_VAD_FILTER=true
WHISPER_VAD_THRESHOLD=0.4
WHISPER_VAD_MIN_SPEECH_MS=200
WHISPER_VAD_MIN_SILENCE_MS=1500
WHISPER_VAD_SPEECH_PAD_MS=800
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
WHISPER_LOG_PROB_THRESHOLD=-1.0
WHISPER_NO_SPEECH_THRESHOLD=0.5
ASR_GUARD_ENABLED=true
ASR_GUARD_MIN_AVG_LOGPROB=-1.25
ASR_GUARD_MAX_NO_SPEECH_PROB=0.75
ASR_GUARD_MAX_COMPRESSION_RATIO=2.6
ASR_SEGMENT_MAX_SECONDS=18
ASR_SEGMENT_MERGE_GAP_SECONDS=0.7
WHISPER_CPP_BIN=tools/whisper.cpp/whisper-cli.exe
WHISPER_CPP_MODEL=models/asr/whisper_cpp/ggml-small-q5_0.bin
WHISPER_CPP_THREADS=6
WHISPER_CPP_LANGUAGE=vi
WHISPER_CPP_TIMEOUT_SECONDS=3600
PHOWHISPER_CPP_MODEL=models/asr/phowhisper_cpp/ggml-phowhisper-large-q5_0.bin
PHOWHISPER_CPP_SHA256=1ECFF4DB87EF84AD1356D2955D2ECEA03E6C240B46FE1CA87F07EA8390E3109C
PHOWHISPER_CPP_SIZE_BYTES=1080732108

# Optional Pyannote diarization. Accept model conditions on Hugging Face first.
HF_TOKEN=
PYANNOTE_MODEL_ID=pyannote/speaker-diarization-community-1
PYANNOTE_FALLBACK_MODEL_ID=pyannote/speaker-diarization-3.1
PYANNOTE_CACHE_DIR=models/pyannote
PYANNOTE_AUTO_DOWNLOAD=false

# Evidence-grounded analysis intelligence
ANALYSIS_INTELLIGENCE_V2_ENABLED=true
ANALYSIS_INTELLIGENCE_LLM_ENABLED=true
ANALYSIS_CLIP_MAX_DURATION_SECONDS=60
ANALYSIS_LLM_PROVIDER=openrouter
ANALYSIS_LLM_BASE_URL=https://openrouter.ai/api/v1
ANALYSIS_LLM_MODEL=google/gemini-2.5-flash
ANALYSIS_LLM_FALLBACK_MODEL=openai/gpt-5-mini
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_HTTP_REFERER=http://localhost:3000
ANALYSIS_LLM_APP_TITLE=cherry2
ANALYSIS_LLM_TIMEOUT_SECONDS=60
ANALYSIS_LLM_MAX_INPUT_CHARS=24000
ANALYSIS_LLM_MAX_OUTPUT_TOKENS=2000
ANALYSIS_LLM_DAILY_BUDGET_USD=
