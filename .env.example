ENVIRONMENT=development
DEBUG=true
AUTH_ENABLED=true
DEV_AUTH_BYPASS=false
DEV_USER_ID=0
INIT_DB_ON_STARTUP=true
ENABLE_API_DOCS=true

# Generate for production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
ACCESS_TOKEN_EXPIRE_MINUTES=30
INITIAL_ADMIN_PASSWORD=change-me-before-first-init
INITIAL_ADMIN_EMAIL=admin@example.com

DATABASE_URL=postgresql://user:password@db:5432/speech_to_information
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=speech_to_information

# Pytest always targets an isolated PostgreSQL database whose name ends in _test.
# For the local test compose service use port 55432.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/speech_to_info_test
TEST_DATABASE_ADMIN_DB=postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3000,http://localhost:8000
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000
FLOWER_PORT=5555
FLOWER_USER=flower
FLOWER_PASSWORD=change-me

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/

RATE_LIMIT_ENABLED=true
MAX_UPLOAD_SIZE=100000000
ALLOWED_EXTENSIONS=["wav","mp3","m4a","ogg"]
AUDIO_STORAGE_ROOT=storage/audio
TRANSCRIPTION_ENGINE=legacy
WHISPER_MODEL=large-v2
WHISPER_USE_LOCAL=true
WHISPER_MODEL_PATH=models/whisper
WHISPER_FAST_MODE=false
# GPU profile (recommended for NVIDIA CUDA): cuda + float16.
# CPU fallback: set WHISPER_DEVICE=cpu and WHISPER_COMPUTE_TYPE=int8.
# The runtime rejects/normalizes unsupported pairs such as cpu + float16.
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=10
ENABLE_HIGH_RISK_AI_FIELDS=false
STORE_RAW_LLM_RESPONSES=false
AI_CONTEXT_RETENTION_DAYS=90

# Clean-clone staging uses the pinned out-of-process llama-server. Acquire it
# only through scripts/install_local_llm_staging.ps1; application startup and
# request handling must never download model/runtime artifacts. The production
# offline bundle is still BLOCKED and is not replaced by this online installer.
LOCAL_LLM_PROVIDER=llama_cpp_server
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLAMA_SERVER_BASE_URL=http://127.0.0.1:8088
# Containers cannot use host loopback. Set this only to a secured llama-server
# sidecar endpoint that is actually reachable from backend/Celery containers.
CONTAINER_LLAMA_SERVER_BASE_URL=
# Backend/Celery mount ./models at /models read-only. The sidecar must expose the
# identical verified GGUF at this exact absolute path in /props.model_path.
CONTAINER_LLAMA_SERVER_MODEL_PATH=/models/qwen3/Qwen3-8B-Q4_K_M.gguf
LLAMA_SERVER_MODEL=speechintel-qwen3-8b-q4_k_m
LLAMA_SERVER_MODEL_PATH=models/qwen3/Qwen3-8B-Q4_K_M.gguf
LLAMA_SERVER_API_KEY=
LLAMA_SERVER_CONTEXT_SIZE=12288
LLAMA_SERVER_MINIMUM_FREE_VRAM_MIB=7000
OFFLINE_STRICT=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
LLAMA_SERVER_SLEEP_IDLE_SECONDS=2
LLAMA_SERVER_SLEEP_WAIT_SECONDS=15
LLM_SEED=42
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=600
SUMMARY_SINGLE_PASS_INVESTIGATION=true
LLM_HEALTH_CACHE_SECONDS=10
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=8192
GPU_LEASE_ENABLED=true
GPU_LEASE_PATH=logs/runtime/gpu.lock
GPU_LEASE_TIMEOUT_SECONDS=900
UNLOAD_MODELS_AFTER_TASK=true
