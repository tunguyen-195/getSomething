@echo off
chcp 65001 > nul

echo ????????????????????????????????????????????????????????????????????????????
echo          Speech to Information System - Services Status                    
echo ????????????????????????????????????????????????????????????????????????????
echo.

echo [Checking Services Status...]
echo.

echo [1/4] Redis Server:
tasklist /FI "IMAGENAME eq redis-server.exe" 2>NUL | find /I /N "redis-server.exe">NUL
if "%ERRORLEVEL%"=="0" (
    echo [OK] Running
) else (
    echo [X] Not Running
)
echo.

echo [2/4] Backend (FastAPI):
netstat -ano | find ":8000" | find "LISTENING" >NUL
if "%ERRORLEVEL%"=="0" (
    echo [OK] Running on http://localhost:8000
) else (
    echo [X] Not Running
)
echo.

echo [3/4] Celery Worker:
tasklist /FI "WINDOWTITLE eq Celery Worker*" 2>NUL | find /I /N "python.exe">NUL
if "%ERRORLEVEL%"=="0" (
    echo [OK] Running
) else (
    echo [X] Not Running
)
echo.

echo [4/4] Frontend (React):
netstat -ano | find ":3000" | find "LISTENING" >NUL
if "%ERRORLEVEL%"=="0" (
    echo [OK] Running on http://localhost:3000
) else (
    echo [X] Not Running
)
echo.

echo ????????????????????????????????????????????????????????????????????????????
echo                             QUICK ACTIONS                                   
echo ????????????????????????????????????????????????????????????????????????????
echo.
echo 1. Start All Services
echo 2. Stop All Services
echo 3. Restart All Services
echo 0. Exit
echo.
pause
