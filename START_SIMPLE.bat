@echo off
echo Starting Backend...
start "Backend" cmd /k "venv\Scripts\python.exe -m uvicorn src.main:app --reload --host 0.0.0.0 --port 8000"

timeout /t 3 > nul

echo Starting Celery...
start "Celery" cmd /k "venv\Scripts\python.exe -m celery -A src.worker.worker worker --pool=gevent --concurrency=4 --loglevel=info --logfile=celery.log"

timeout /t 3 > nul

echo Starting Frontend...
start "Frontend" cmd /k "cd frontend && npm run dev"

echo.
echo ???????????????????????????????????????????????????????????????????????
echo    All services started! Check the 3 windows opened.
echo    Backend:  http://localhost:8000
echo    Frontend: http://localhost:3000
echo ???????????????????????????????????????????????????????????????????????
pause
