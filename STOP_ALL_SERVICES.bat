@echo off
chcp 65001 > nul

echo ????????????????????????????????????????????????????????????????????????????
echo          Speech to Information System - Stop All Services                  
echo ????????????????????????????????????????????????????????????????????????????
echo.

echo [1/4] Stopping Frontend (Node.js)...
taskkill /F /FI "WINDOWTITLE eq Frontend - React*" 2>NUL
for /f "tokens=2" %%a in ('tasklist /FI "IMAGENAME eq node.exe" /FO LIST ^| find "PID:"') do taskkill /F /PID %%a 2>NUL
echo [OK] Frontend stopped
echo.

echo [2/4] Stopping Celery Worker...
taskkill /F /FI "WINDOWTITLE eq Celery Worker*" 2>NUL
echo [OK] Celery Worker stopped
echo.

echo [3/4] Stopping Backend (Uvicorn)...
taskkill /F /FI "WINDOWTITLE eq Backend - FastAPI*" 2>NUL
for /f "tokens=5" %%a in ('netstat -ano ^| find ":8000" ^| find "LISTENING"') do taskkill /F /PID %%a 2>NUL
echo [OK] Backend stopped
echo.

echo [4/4] Stopping Redis Server...
taskkill /F /FI "WINDOWTITLE eq Redis Server*" 2>NUL
taskkill /F /IM redis-server.exe 2>NUL
echo [OK] Redis stopped
echo.

echo ????????????????????????????????????????????????????????????????????????????
echo                       ALL SERVICES STOPPED                                  
echo ????????????????????????????????????????????????????????????????????????????
echo.
echo All services have been terminated.
echo You can restart them by running: START_ALL_SERVICES.bat
echo.
pause
