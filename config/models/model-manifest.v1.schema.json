{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speech-to-information:model-manifest:v1",
  "title": "SpeechToInformation offline model manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "model"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "relative_path",
        "tasks",
        "profiles",
        "artifact_size_bytes",
        "source",
        "license",
        "backend",
        "files"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "tasks": {"$ref": "#/$defs/identifiers"},
        "profiles": {"$ref": "#/$defs/identifiers"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "repository", "revision"],
          "properties": {
            "provider": {"$ref": "#/$defs/identifier"},
            "repository": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1}
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "name", "url"],
          "properties": {
            "spdx": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1}
          }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "format", "quantization"],
          "properties": {
            "engine": {"$ref": "#/$defs/identifier"},
            "format": {"$ref": "#/$defs/identifier"},
            "quantization": {"type": ["string", "null"]}
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "size_bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "required": {"type": "boolean", "default": true}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
