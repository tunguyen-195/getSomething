        "separate_gate": "source-workspace historical evidence audit"
      },
      {
        "nodeid": "tests/test_investigation_knowledge.py::test_committed_schema_artifact_matches_current_models",
        "category": "historical_evidence",
        "reason_code": "S1_SCHEMA_EVIDENCE",
        "rationale": "Checks a curated prior-phase schema artifact that is excluded from the runtime release.",
        "required_paths": [
          "docs/reviews/artifacts/s1-summary-schema.json"
        ],
        "separate_gate": "source-workspace historical evidence audit"
      },
      {
        "nodeid": "tests/test_summary_diarization_audit_harness.py::test_pyannote_migration_audit_is_current_and_source_bound",
        "category": "historical_evidence",
        "reason_code": "PYANNOTE_RESEARCH_EVIDENCE",
        "rationale": "Binds a dated research capture and migration audit that is not part of the runtime candidate.",
        "required_paths": [
          "docs/reviews/artifacts/2026-08-09-pyannote-migration-config-audit.json",
