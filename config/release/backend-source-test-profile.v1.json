        "reason_code": "REFERENCE_RESEARCH_BUNDLE",
        "rationale": "Validates the research reference-repository evidence bundle, not shipped runtime behavior.",
        "required_paths": [
          "docs/research/reference-repo-audit",
          "docs/reviews/reference-repository-reuse-audit-2026-08-09.md"
        ],
        "separate_gate": "source-workspace research evidence audit"
      },
      {
        "nodeid": "tests/test_audit_reference_repos.py::test_reference_port_register_covers_every_decision_and_forbids_copying",
        "category": "historical_evidence",
        "reason_code": "REFERENCE_RESEARCH_REGISTER",
        "rationale": "Requires the non-release research decision register and its source evidence.",
        "required_paths": [
          "docs/research/reference-repo-audit",
          "docs/reviews/reference-repository-reuse-audit-2026-08-09.md"
        ],
        "separate_gate": "source-workspace research evidence audit"
      },
      {
        "nodeid": "tests/test_audit_reference_repos.py::test_reference_port_register_rejects_permissive_copy_policy",
        "category": "historical_evidence",
        "reason_code": "REFERENCE_RESEARCH_REGISTER",
        "rationale": "Requires the non-release research decision register and its source evidence.",
        "required_paths": [
          "docs/research/reference-repo-audit",
          "docs/reviews/reference-repository-reuse-audit-2026-08-09.md"
        ],
        "separate_gate": "source-workspace research evidence audit"
      },
      {
        "nodeid": "tests/test_audit_reference_repos.py::test_reference_port_register_rejects_incomplete_source_evidence",
        "category": "historical_evidence",
        "reason_code": "REFERENCE_RESEARCH_REGISTER",
        "rationale": "Builds a negative fixture from research evidence that is intentionally not shipped.",
        "required_paths": [
          "docs/research/reference-repo-audit",
          "docs/reviews/reference-repository-reuse-audit-2026-08-09.md"
        ],
        "separate_gate": "source-workspace research evidence audit"
      },
      {
        "nodeid": "tests/test_audit_reference_repos.py::test_reference_port_register_rejects_forged_source_identity",
        "category": "historical_evidence",
        "reason_code": "REFERENCE_RESEARCH_REGISTER",
        "rationale": "Builds a negative fixture from research evidence that is intentionally not shipped.",
        "required_paths": [
          "docs/research/reference-repo-audit",
          "docs/reviews/reference-repository-reuse-audit-2026-08-09.md"
        ],
        "separate_gate": "source-workspace research evidence audit"
      },
      {
        "nodeid": "tests/test_context_eval_harness.py::test_s1_evidence_mode_uses_exact_closed_contract_checks",
        "category": "historical_evidence",
        "reason_code": "S1_SCHEMA_EVIDENCE",
        "rationale": "Checks a prior-phase S1 evidence artifact rather than current runtime behavior.",
        "required_paths": [
          "docs/reviews/artifacts/s1-summary-schema.json"
