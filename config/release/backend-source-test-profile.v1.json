        "category": "external_artifact",
        "reason_code": "GATED_MODEL_NOT_IN_GIT",
        "rationale": "Requires operator-acquired gated Pyannote model files that must not be committed to Git.",
        "required_paths": [
          "models/pyannote"
        ],
        "separate_gate": "post-acquisition model manifest and preflight gate"
      },
      {
        "nodeid": "tests/test_startup_runtime_profile.py::test_primary_startup_uses_single_gpu_safe_worker_without_runtime_install",
        "category": "legacy_noncanonical",
        "reason_code": "OBSOLETE_STARTUP_LAUNCHER",
        "rationale": "The canonical new-machine runbook explicitly rejects START_ALL_SERVICES.bat for the pinned LLM staging profile.",
        "required_paths": [
          "START_ALL_SERVICES.bat"
        ],
        "separate_gate": "legacy launcher retirement review"
      }
    ]
  },
  "candidate_binding": {
    "required": true,
    "accepted_rehearsal_schema_versions": [
      "stt-release-candidate-rehearsal-v4"
    ],
    "fingerprint_field": "candidate.workspace_content_fingerprint_sha256",
    "manifest_verdict_required": "PASS",
    "content_scan_blocked_forbidden": true
  },
  "limitations": [
    "A passing backend source profile is not an overall production release verdict.",
    "External model acquisition, frontend, Docker, migrations, security, preflight, and real Summary/Analysis replay remain separate mandatory gates.",
    "Historical evidence tests remain required in the source workspace but do not justify shipping raw research or replay artifacts."
  ]
}
