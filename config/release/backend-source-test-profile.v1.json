{
  "schema_version": "stt-release-test-profile-v1",
  "profile_id": "backend-source-clean-clone-v1",
  "scope": "backend source and clean-clone behavior before external model acquisition",
  "test_root": "tests",
  "pytest_args": [
    "-q"
  ],
  "selection": {
