  + description: Text
  + status_id: Integer {FK}
  + priority_id: Integer {FK}
  + created_by: Integer {FK}
  + closed_at: DateTime
  + is_archived: Boolean
  + archive_reason: Text
  + case_metadata: JSON
}

class CaseStatus {
  + id: Integer {PK}
  + status_name: String(50) {UK}
  + description: Text
  + is_active: Boolean
