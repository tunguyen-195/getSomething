' Base Model
abstract class BaseModel {
  + id: Integer {PK}
  + created_at: DateTime
  + updated_at: DateTime
}

' User Management
class User {
  + id: Integer {PK}
  + username: String {UK}
  + email: String {UK}
  + password_hash: String
  + full_name: String
  + is_active: Boolean
  + last_login: DateTime
  + role_id: Integer {FK}
  __
  + set_password(password: str): void
  + check_password(password: str): bool
}

class UserRole {
  + id: Integer {PK}
  + role_name: String {UK}
  + description: Text
  + permissions: JSON
}

' Case Management
class Case {
